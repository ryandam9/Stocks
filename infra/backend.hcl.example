# Copy to backend.hcl and fill in, then:
#
#   terraform init -backend-config=backend.hcl
#
# backend.hcl is gitignored -- bucket names identify the account. Create the
# state bucket first with infra/bootstrap.

bucket  = "your-terraform-state-bucket"
key     = "stocks/terraform.tfstate"
region  = "ap-southeast-2"
encrypt = true

# S3-native locking: Terraform takes a conditional-write lock on a .tflock
# object beside the state file. No DynamoDB table to provision or pay for.
# Supersedes the deprecated dynamodb_table parameter.
use_lockfile = true
