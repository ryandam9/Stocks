# Copy to backend.hcl and fill in, then:
#
#   terraform init -backend-config=backend.hcl
#
# backend.hcl is gitignored -- bucket names identify the account. Create the
# bucket and lock table first with infra/bootstrap.

bucket         = "your-terraform-state-bucket"
key            = "stocks/terraform.tfstate"
region         = "ap-southeast-2"
dynamodb_table = "terraform-locks"
encrypt        = true

# Terraform 1.11+ deprecates dynamodb_table in favour of S3-native locking.
# To migrate: drop the line above, add `use_lockfile = true`, re-run init, and
# delete the table. Kept as-is because the lock table is what is provisioned.
