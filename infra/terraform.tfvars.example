# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored: this
# repository is public and these values identify your account.
#
#   cp terraform.tfvars.example terraform.tfvars

# Existing bucket the databases are published to. Name only, no s3:// scheme.
data_bucket = "your-bucket"

# Subscribed to the alert topic: a run broke, or none happened in 24 h. AWS
# emails a confirmation link on first apply; until you click it, no alert is
# delivered. Unless notify_email overrides it, this also receives the ~2/day
# "database published" mail.
alert_email = "you@example.com"

# Domain the "database published" mail is sent from, as Stocks <stocks@...>.
# It needs a public Route 53 hosted zone in this account -- terraform writes
# the three DKIM CNAMEs into it, and SES verifies the domain a few minutes
# after they resolve. Sending from a domain you do not control (a gmail.com
# From, say) fails DMARC alignment and lands in spam.
notify_domain = "example.com"

# Optional overrides -- defaults are in variables.tf.
# Set only to send the ~2/day "database published" mail somewhere other than
# alert_email -- a different mailbox, or a shared one.
# notify_email       = "you@example.com"

# region             = "ap-southeast-2"
# vpc_cidr           = "10.20.0.0/16"
# image_tag          = "latest"
# log_retention_days = 30

# Apply the stack without arming the schedules, for phase 2 of the rollout.
# schedule_enabled = false
