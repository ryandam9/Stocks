# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Logs
*.log
logs/

# Data / outputs (generated, and far too large to track)
data/
*.db
*_eod.csv
*_growth*.csv
*_error.csv

# Local env / editors
.env
.env.local
.vscode/
.idea/
.DS_Store

# Test / tooling caches
.pytest_cache/
.ruff_cache/

# Terraform. tfvars carries the account ID, bucket name and alert address;
# state files embed resolved ARNs. Neither belongs in a public repository.
*.tfvars
*.tfvars.json
*.tfstate
*.tfstate.*
.terraform/
backend.hcl
# .terraform.lock.hcl is deliberately NOT ignored: committing it pins provider
# versions and hashes, and it holds nothing account-specific.
