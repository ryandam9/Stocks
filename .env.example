# Machine-specific settings. Copy to .env and edit; .env is not tracked.
#
# Where generated data lives (CSVs, SQLite databases). Relative data_dir and
# db_path values in config/*.yaml resolve against this. Defaults to
# <repo>/data when unset.
STOCKS_DATA_ROOT=/absolute/path/to/your/data

# Optional: publish the built database to S3 with --upload.
# S3_BUCKET=s3://your-bucket
# S3_REGION=ap-southeast-2

# Upload on every run without passing --upload. Only takes effect when
# S3_BUCKET is also set.
# S3_AUTO_UPLOAD=true

# Credentials are NOT read from this file by the containers: .env is excluded
# from the image, and the container runs as uid 10001 so it cannot read a
# 0600 ~/.aws/credentials. docker-compose.yml forwards AWS_* from the calling
# shell instead; populate them with:
#
#   eval "$(aws configure export-credentials --format env)"
